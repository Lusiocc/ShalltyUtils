<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net46</TargetFramework>
		<RootNamespace>ShalltyUtils</RootNamespace>
		<AssemblyName>HS2_ShalltyUtils</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="IllusionModdingAPI.HS2API" Version="1.43.0" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Timeline">
			<HintPath>$(HSPluginsBin)Timeline.HS2\Timeline.dll</HintPath>
			<Aliases>global,aliasTimeline</Aliases>
			<Private>false</Private>
		</Reference>
		<Reference Include="HS2PE">
			<HintPath>$(HSPluginsBin)PoseEditor.HS2\HS2PE.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NodesConstraints">
			<HintPath>$(HSPluginsBin)NodesConstraints.HS2\NodesConstraints.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Publicize Include="Timeline" MemberPattern="^(Timeline|UILib)\..*" />
		<Publicize Include="HS2PE" MemberPattern="^HSPE\..*" />
		<Publicize Include="NodesConstraints" MemberPattern="^NodesConstraints\..*" />
	</ItemGroup>
	<Import Project="..\ShalltyUtils.Core\ShalltyUtils.Core.projitems" Label="Shared" />
	<Import Project="$(HSPluginsDir)ToolBox\ToolBox.projitems" Label="Shared" />
</Project>
