<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net46</TargetFramework>
		<RootNamespace>ShalltyUtils</RootNamespace>
		<AssemblyName>KKS_ShalltyUtils</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="IllusionModdingAPI.KKSAPI" Version="1.43.0" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Timeline">
			<HintPath>$(HSPluginsBin)Timeline.KKS\Timeline.dll</HintPath>
			<Aliases>global,aliasTimeline</Aliases>
			<Private>false</Private>
		</Reference>
		<Reference Include="KKSPE">
			<HintPath>$(HSPluginsBin)PoseEditor.KKS\KKSPE.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NodesConstraints">
			<HintPath>$(HSPluginsBin)NodesConstraints.KKS\NodesConstraints.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Publicize Include="Timeline" MemberPattern="^(Timeline|UILib)\..*" />
		<Publicize Include="KKSPE" MemberPattern="^HSPE\..*" />
		<Publicize Include="NodesConstraints" MemberPattern="^NodesConstraints\..*" />
	</ItemGroup>
	<Import Project="..\ShalltyUtils.Core\ShalltyUtils.Core.projitems" Label="Shared" />
	<Import Project="$(HSPluginsDir)ToolBox\ToolBox.projitems" Label="Shared" />
</Project>
