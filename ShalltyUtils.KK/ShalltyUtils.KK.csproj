<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net35</TargetFramework>
		<RootNamespace>ShalltyUtils</RootNamespace>
		<AssemblyName>KK_ShalltyUtils</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="IllusionModdingAPI.KKAPI" Version="1.43.0" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Timeline">
			<HintPath>$(HSPluginsBin)Timeline.KK\Timeline.dll</HintPath>
			<Aliases>global,aliasTimeline</Aliases>
			<Private>false</Private>
		</Reference>
		<Reference Include="KKPE">
			<HintPath>$(HSPluginsBin)PoseEditor.KK\KKPE.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NodesConstraints">
			<HintPath>$(HSPluginsBin)NodesConstraints.KK\NodesConstraints.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Publicize Include="Timeline" MemberPattern="^(Timeline|UILib)\..*" />
		<Publicize Include="KKPE" MemberPattern="^HSPE\..*" />
		<Publicize Include="NodesConstraints" MemberPattern="^NodesConstraints\..*" />
	</ItemGroup>
	<Import Project="..\ShalltyUtils.Core\ShalltyUtils.Core.projitems" Label="Shared" />
	<Import Project="$(HSPluginsDir)ToolBox\ToolBox.projitems" Label="Shared" />
</Project>
